{
  "name": "erp",
  "version": "0.1.15",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown --ignore-path .gitignore",
    "test": "vitest run",
    "bootstrap:admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build:assets": "node scripts/build-desktop.mjs",
    "desktop:build:dir": "npm run desktop:build:assets && electron-builder --config electron-builder.config.cjs --dir --win --publish never",
    "desktop:build": "npm run desktop:build:assets && electron-builder --config electron-builder.config.cjs --win nsis --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-strike": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-underline": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@uiw/react-markdown-preview": "5.2.1",
    "bcryptjs": "^3.0.3",
    "daterangepicker": "^3.1.0",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.11",
    "jose": "^6.2.15",
    "jquery": "^3.7.1",
    "lucide-react": "^1.52.0",
    "moment": "^2.30.1",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.4.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "vn.landuyinh.erp",
    "productName": "ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules"
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      },
      {
        "from": "build/postgrest-runtime",
        "to": "desktop"
      },
      {
        "from": "supabase/migrations",
        "to": "desktop/migrations"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP"
    },
    "publish": []
  }
}
